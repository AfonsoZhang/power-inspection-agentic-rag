# ---------------------------------------------------------------------------
# 只需配置 config.yaml 里 llm.api_key_env 指定的那一个变量；
# 找不到时会回落到通用的 LLM_API_KEY。
# ---------------------------------------------------------------------------

# 默认 provider（DeepSeek）
DEEPSEEK_API_KEY=sk-your-key-here

# 通用回落（任何 provider 都会读它）
# LLM_API_KEY=sk-your-key-here

# 多模态模型（可选）。config.yaml 的 vlm.enabled=true 时才需要。
# 示例：通义千问 VL（OpenAI 兼容）
# DASHSCOPE_API_KEY=sk-your-key-here
# VLM_API_KEY=sk-your-key-here

# 调试模式
DEBUG=0
